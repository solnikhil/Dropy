{
  "name": "dropy-tools",
  "private": true,
  "type": "module",
  "description": "Dropy's development tooling (benchmarks and checks), run with Bun.",
  "scripts": {
    "bench": "Scripts/bench/run-suite.sh",
    "bench:check": "bun Scripts/bench/suite.ts check",
    "bench:compare": "bun Scripts/bench/suite.ts compare",
    "bench:list": "bun Scripts/bench/suite.ts list",
    "latency-summary": "bun Scripts/bench/latency-summary.ts",
    "animation:docs": "./.build/local/Dropy.app/Contents/MacOS/Dropy animation docs --generic > docs/ANIMATIONS.md",
    "bench:plan": "bun Scripts/bench/suite.ts plan",
    "bench:build": "bun Scripts/bench/suite.ts build",
    "bench:preflight": "bun Scripts/bench/suite.ts preflight",
    "bench:legacy": "bun Scripts/bench/bench.ts run",
    "bench:test": "bun test Tests/BenchProbeTests.test.ts Tests/BenchmarkSuiteTests.test.ts"
  }
}
